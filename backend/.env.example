# Alibaba Cloud Model Studio text, speech and optional illustrations (China Beijing).
# Keep both secrets out of this example and Git.
# Used for speech and optional illustrations; never used as a fallback for the text model.
DASHSCOPE_API_KEY=
# Set the full OpenAI-compatible endpoint together with MODEL_API_KEY.
MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Use a Model Studio key authorized for text in the endpoint's workspace and region.
MODEL_API_KEY=
MODEL_NAME=qwen3.6-plus

# Ordinary text calls: total deadline, greater than 0 and at most 20 seconds.
MODEL_TIMEOUT_SECONDS=20
# Integer 1..4096. A truncated answer is rejected, never automatically retried.
MODEL_MAX_TOKENS=512
# Optional cap for illustrated story text. The global cap above still applies.
MODEL_WORKSHOP_ILLUSTRATION_MAX_TOKENS=1536
# Send enable_thinking=false. Set false only to omit that field for a compatible endpoint.
MODEL_SEND_THINKING=true

ASR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ASR_MODEL=qwen3-asr-flash
# Set the full URL using YOUR Beijing workspace ID (no API key in the URL):
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# Empty disables TTS until configured; ASR remains independent.
TTS_API_URL=
TTS_MODEL=qwen-audio-3.1-tts-flash
# Default voice: any exact ID from `python backend/smoke_voice.py options`.
# The six selected qwen-audio-3.1-tts-flash voices are bundled in app/voice_catalog.json.
# Per-call voice and SLOW/NORMAL/FAST synthesis rate do not mutate this default.
TTS_VOICE=wenhuaiqing_v3.1
# Total budget includes synthesis AND audio download; no automatic retry.
VOICE_TIMEOUT_SECONDS=20

# Optional. Set the full URL for your Model Studio workspace to enable AI illustrations.
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Blank reuses the official workspace host in TTS_API_URL. Set the full endpoint for a different workspace.
IMAGE_API_URL=
IMAGE_MODEL=qwen-image-3.0-pro
