# DeepSeek text + Alibaba Cloud Model Studio speech (China Beijing).
# Keep both secrets out of this example and Git. Keys are NOT interchangeable.
# Speech only; never used as a fallback for the text model.
DASHSCOPE_API_KEY=
# Full DeepSeek endpoint, not the SDK base URL.
MODEL_API_URL=https://api.deepseek.com/chat/completions
# Fill a DeepSeek official API key here, not a DashScope key.
MODEL_API_KEY=
MODEL_NAME=deepseek-flash

# Ordinary text calls: total deadline, greater than 0 and at most 20 seconds.
MODEL_TIMEOUT_SECONDS=20
# Integer 1..4096. A truncated answer is rejected, never automatically retried.
MODEL_MAX_TOKENS=512

ASR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ASR_MODEL=qwen3-asr-flash
# Set the full URL using YOUR Beijing workspace ID (no API key in the URL):
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# Empty disables TTS until configured; ASR remains independent.
TTS_API_URL=
TTS_MODEL=qwen-audio-3.1-tts-flash
# Default voice: any exact ID from `python backend/smoke_voice.py options`.
# The six selected qwen-audio-3.1-tts-flash voices are bundled in app/voice_catalog.json.
# Per-call voice and SLOW/NORMAL/FAST synthesis rate do not mutate this default.
TTS_VOICE=wenhuaiqing_v3.1
# Total budget includes synthesis AND audio download; no automatic retry.
VOICE_TIMEOUT_SECONDS=20
