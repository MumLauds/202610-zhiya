{
  "name": "zhiya-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:public": "vite build --mode public",
    "build:html-review": "vite build --config vite.html.config.js && node scripts/inline-html-review.cjs",
    "check": "npm test -- --maxWorkers=2 && npm run test:mobile && npm run build:public",
    "test": "vitest run",
    "test:mobile": "node --test tests/readingSessionMachine.test.js tests/mobileWriteRecovery.test.js"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
